[Unit]
Description=Beam Studio host updater
Documentation=https://github.com/Beam-Network/beam-studio-public
# After Docker, never Before: the updater drives Docker (startup recovery runs
# `docker compose`). So after a reboot dockerd restarts the Studio containers
# first, and the api container must start without the socket; it mounts the
# socket's directory for that reason (deploy/compose.release.template.yml).
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=DOCKER_CONFIG=/etc/beam-studio/docker
ExecStart=/usr/local/bin/beam-updater serve --config /etc/beam-studio/updater.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=31min
RuntimeDirectory=beam-studio
RuntimeDirectoryMode=0770
# The api container bind-mounts this directory. Removing it when the updater
# stops would leave the container holding a deleted directory, blind to the
# socket the next start creates. /run is emptied at reboot anyway.
RuntimeDirectoryPreserve=yes
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/beam-studio /run/beam-studio
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
