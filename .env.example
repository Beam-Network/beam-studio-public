# Docker Compose example profile. Override it with BEAM_STUDIO_ENV_FILE when
# selecting .env.dev, .env.local, or .env.prod.
NODE_ENV=production

# PostgreSQL control plane
# Compose builds DATABASE_URL from POSTGRES_PASSWORD, which has no default: the
# stack refuses to start until it is set. It is read by Compose interpolation,
# so it belongs in the project-root .env or the shell, not in this file:
#   echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)" >> .env
# Postgres and NATS are reached over the Compose network by service name and are
# not published to the host. Use `docker compose exec postgres psql -U beam
# beam_studio` rather than connecting to a published port.
# Use beam_studio, not beam-studio, so SQL and backup tooling do not need quotes.
ORCHESTRATION_DATABASE_MODE=postgresql

# NATS JetStream task transport
NATS_URL=nats://nats:4222
NATS_TASK_SUBJECT=beam.workflow.tasks
NATS_TASK_STREAM=BEAM_WORKFLOW_TASKS
NATS_TASK_DLQ_SUBJECT=beam.workflow.tasks.dlq.permanent
NATS_WORKER_QUEUE_GROUP=beam-studio-workers

# Optional remote Execution Orchestrator backend. Keep disabled to use legacy workers.
REMOTE_EXECUTION_ENABLED=false
REMOTE_EXECUTION_TASK_SUBJECT=beam.workloads.studio.tasks
REMOTE_EXECUTION_RESULT_SUBJECT=beam.workloads.studio.results
REMOTE_EXECUTION_OWNER_ID=beam-orchestrator
REMOTE_EXECUTION_LEASE_MS=3600000
REMOTE_EXECUTION_SANDBOX_RUNTIME=wasi
REMOTE_EXECUTION_ARTIFACT_URL_BASE=

# Studio runtime and authentication
# Required, with no default and no fallback: a shared default would be a key
# published in this repository. Every service refuses to start without it, and
# rejects the placeholders this repo has shipped. Compose reads it by
# interpolation, so set it in the project-root .env or the shell:
#   echo "BEAM_STUDIO_SECRET_KEY=$(openssl rand -hex 32)" >> .env
# `pnpm dev:stack` generates one into .env.local for local development.
BEAM_STUDIO_SECRET_KEY=
# Keys that may still decrypt, comma separated. Empty except during a rotation:
# put the previous key here, generate a new BEAM_STUDIO_SECRET_KEY, restart
# every service, run `pnpm --filter @beam-studio/api vault:rotate`, and
# clear this once the rotation reports complete. Removing a key before then
# destroys every secret still written under it.
BEAM_STUDIO_SECRET_KEY_RETIRED=
# Studio room consumer bootstrap. The consumer presents this secret to
# POST /agent-control/v1/bootstrap; the installer generates it for release
# installs (openssl rand -hex 32). Empty disables consumer bootstrap.
BEAM_STUDIO_SHARED_SECRET=
# Organization the room consumer enrolls for. Leave empty to use the instance
# owner (the organization that claimed this Studio); the hosted deployment sets
# it explicitly.
BEAM_STUDIO_CONSUMER_ORGANIZATION_ID=
# Recovery lever for instance ownership. Leave empty. If a claim in
# Settings -> Access went to the wrong Beam organization, set this to the right
# organization's ID and restart the api: it becomes the owner at start-up (the
# join policy is not touched). Clear it again afterwards, or every restart
# re-asserts it.
BEAM_STUDIO_OWNER_ORGANIZATION_ID=
# Keep secure cookies enabled whenever Studio is served over HTTPS.
BEAM_STUDIO_SECURE_COOKIES=true
BEAM_STUDIO_DEV_SETTINGS_ENABLED=false
# Log level for the api, orchestrator, worker and mcp services: fatal, error,
# warn, info (default), debug, trace or silent. At info each write request and
# every 4xx/5xx is logged; successful reads are debug; health probes are not
# logged. Secrets (auth headers, cookies, API keys, tokens, credential
# payloads) are redacted at every level.
LOG_LEVEL=info
# Room Workflows (distributed workflow-graph/v3) ship in a later release. Keep
# both flags false outside feature development; the VITE_ one is read at build.
BEAM_STUDIO_ROOM_WORKFLOWS=false
VITE_STUDIO_ROOM_WORKFLOWS=false
# Beam Studio is the public OAuth client "beam-studio" (no client secret).
# Production defaults are shown here; override with localhost for local Beam services.
BEAM_AUTH_URL=https://auth.b1m.ai
BEAM_API_URL=https://api.b1m.ai
NEXT_PUBLIC_CONSOLE_URL=https://console.b1m.ai
# Optional. A bm_sa_ service account credential, read-only, used to show budget
# threshold alerts in Studio. Without it the budget warning bar stays hidden.
BEAM_MANAGEMENT_CREDENTIAL=
# Optional base path: per-browser encrypted tokens live in <path>.sessions/.
# The legacy single-session file is not imported.
# BEAM_STUDIO_AUTH_STORE_PATH=/absolute/private/path/oauth-session.json
NEXT_PUBLIC_APP_NAME=BEAM Transfer Studio
NEXT_PUBLIC_TRANSFER_STUDIO_URL=http://localhost:3000
# Compatibility alias consumed by the Studio API configuration.
NEXT_PUBLIC_API_URL=http://localhost:3002

# Beam services
BEAM_DEFAULT_BASE_URL=https://beamcore.b1m.ai
BEAM_DEFAULT_COORDINATOR_URL=https://coordinator.b1m.ai
BEAM_DEFAULT_REGISTRY_URL=https://api.b1m.ai/registry
BEAM_DEFAULT_NATS_URL=tls://orch-gateway.b1m.ai:4222
BEAM_ENV=prod
BEAM_SERVER_OPTIONS=https://beamcore.b1m.ai
BEAM_ACTION_REGISTRY_URL=https://api.b1m.ai/registry

# Local service bindings
# Every service binds 127.0.0.1 unless told otherwise, so a service nobody
# configured is not reachable from the network. The values below suit running
# the services directly on one machine (pnpm dev). Only the Studio web server is
# expected to face a host interface.
#
# In containers, 127.0.0.1 is the container's own loopback: other containers
# and published ports cannot reach it. API_BIND_HOST, ORCHESTRATOR_BIND_HOST,
# WORKER_OBSERVABILITY_BIND_HOST and MCP_SERVER_HOST must be 0.0.0.0 there. The
# repository Compose files and the release template set that in `environment:`,
# which overrides this file; a hand-written Compose file or `docker run
# --env-file` has to set it too. Which ports reach the host is then decided by
# what is published, not by these values.
API_PORT=8787
API_BIND_HOST=127.0.0.1
ORCHESTRATOR_PORT=8788
ORCHESTRATOR_BIND_HOST=127.0.0.1
WORKER_OBSERVABILITY_PORT=8790
WORKER_OBSERVABILITY_BIND_HOST=127.0.0.1
ORCHESTRATOR_URL=http://orchestrator:8788
# Hostnames this installation answers to. Loopback names and IP literals are
# always accepted, so an install reached at http://<ip>:3004 needs nothing here.
# A DNS name has to be listed, otherwise a rebound name could drive the local
# install from a page the operator visits.
BEAM_STUDIO_ALLOWED_HOSTS=
# Inlined into the browser bundle at build time; setting it at runtime does
# nothing. The Studio SPA uses the same-origin proxy below only when this URL
# is a loopback address and the page is not.
VITE_STUDIO_API_URL=http://localhost:8787
# Where /__studio_api/* forwards. No default: unset disables the proxy.
STUDIO_API_PROXY_TARGET=http://api:8787
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8766
MCP_SERVER_URL=http://localhost:8766/mcp
MCP_CORS_ORIGINS=http://localhost:3004
MCP_AUTH_RATE_LIMIT_PER_MINUTE=60
MCP_TOKEN_RATE_LIMIT_PER_MINUTE=120

# Worker scheduler and action sandbox
WORKER_CONCURRENCY=3
# Aggregate in-flight task capacity for the shared worker queue. Set this to
# worker replicas multiplied by WORKER_CONCURRENCY.
WORKER_FLEET_CONCURRENCY=9
WORKER_LOCK_TTL_MS=900000
WORKER_CANCELLATION_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=3
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_STALE_WORKER_TTL_MS=60000
WORKER_DRAIN_MODE=false
WORKER_ACTION_CACHE_DIR=/tmp/beam-action-cache
WORKER_PROCESS_OWNERSHIP_DIR=/data/beam-action-ownership
WORKER_ACTION_ALLOWED_PERMISSIONS=storage:read,storage:write,storage:list,network:http,network:nats,beam:transfer-create,beam:transfer-read,beam:transfer-cancel
WORKER_TRUSTED_NODE_ACTION_PACKAGES=@beam/transfer,@beam/room-transfer
WORKER_TRUSTED_NODE_ALLOWED_NETWORK=127.0.0.1:4222,orch-gateway.b1m.ai:4222
WORKER_ACTION_SANDBOX_TIMEOUT_MS=300000
WORKER_ACTION_SCRATCH_DIR=/data/beam-worker-scratch
WORKER_ACTION_SCRATCH_MAX_BYTES=10737418240
WORKER_FILE_SERVER_ENABLED=false
WORKER_FILE_SERVER_HOST=127.0.0.1
# Not 8787: that is the API's port, and both can run on one host.
WORKER_FILE_SERVER_PORT=8791
WORKER_FILE_SERVER_MAX_TTL_SECONDS=3600
# Required when WORKER_FILE_SERVER_ENABLED=true, and shared by every replica.
# It used to fall back to a per-process random value, which silently invalidated
# every signed URL on restart and across replicas.
WORKER_FILE_SERVER_SIGNING_SECRET=

# Registry artifact access
HIPPIUS_S3_ENDPOINT=https://s3.hippius.com
HIPPIUS_S3_REGION=decentralized
HIPPIUS_S3_FORCE_PATH_STYLE=true
HIPPIUS_S3_ACCESS_KEY_ID=
HIPPIUS_S3_SECRET_ACCESS_KEY=

# Internal Studio API reached only by the worker host, not action sandboxes.
BEAM_STUDIO_API_URL=http://api:8787

# Room control needs no static credential: requests use the Beam Auth session,
# background work uses the organization Beam API keys stored in Studio.

BEAM_STUDIO_UPDATE_MODE=managed
