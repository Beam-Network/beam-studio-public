      ],
      "name": "Hugging Face",
      "driver": "s3-compatible",
      "status": "ready",
      "logo": "/provider-logos/huggingface.png",
      "website_url": "https://huggingface.co/storage",
      "docs_url": "https://huggingface.co/docs/hub/en/storage-buckets-s3",
      "region": {
        "default": "us-east-1"
      },
      "endpoint": {
        "required": false,
        "template": "https://s3.hf.co/{namespace}",
        "object_metadata_readback": false,
        "template_variables": [
          "namespace"
        ],
        "force_path_style": true
      },
      "credential_fields": {
        "required": [
          "access_key_id",
          "secret_access_key",
          "namespace"
        ],
        "optional": [
          "region",
          "endpoint_url"
        ]
      },
      "notes": [
        "S3 credentials are generated from a Hugging Face access token: Access Tokens settings, then Generate S3 credentials. The access key is prefixed HFAK.",
        "The gateway serves Storage Buckets only. Dataset, model, and Space repositories are not reachable over S3.",
        "The namespace is your username or organization and scopes the endpoint; the bucket name is passed on its own."
      ]
    },
